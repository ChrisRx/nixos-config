@@ -4319,6 +4336,36 @@ static int luaConfig(lua_State* L) {
         if (!SET_NUM(idx, "spawn_distance", g_cfgSpawnDistance,
                      "windows.spawn_distance"))
             return luaL_error(L, "hypr3d.config: windows.spawn_distance must be a number");
+
+        // Compiled here and only here: regex construction throws on a bad
+        // pattern, and this is the one place that can turn it into a lua
+        // error the user sees at reload (`hyprctl configerrors`) rather than
+        // an exception escaping the enumerator mid-frame.
+        //
+        // Live in both directions: refreshCaptures' retainOnly drops the
+        // snapshots of anything that stopped being enumerated and syncWorld
+        // rebuilds the entity list from the same call, so a namespace added
+        // to or removed from the pattern takes effect on the next frame.
+        if (!SET_STRING(idx, "layer_exclude", g_cfgLayerExclude,
+                        "windows.layer_exclude"))
+            return luaL_error(L, "hypr3d.config: windows.layer_exclude must be a string");
+
+        if (g_cfgLayerExclude.empty())
+            g_layerExcludeRe.reset();
+        else {
+            try {
+                g_layerExcludeRe.emplace(g_cfgLayerExclude,
+                                         std::regex::ECMAScript |
+                                             std::regex::optimize);
+            } catch (const std::regex_error& e) {
+                g_layerExcludeRe.reset();
+                return luaL_error(
+                    L,
+                    "hypr3d.config: windows.layer_exclude is not a valid regex: %s",
+                    e.what());
+            }
+        }
+
         lua_pop(L, 1);
     }
 
