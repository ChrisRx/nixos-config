+// True for the one event per gesture that CSeatManager turns into
+// wl_pointer.axis_stop, when stop_on_lift asks for that event to be withheld
+// from the client. Cancelling it in the axis callback is the only way to stop a
+// client's own kinetic scrolling: GTK, Chromium and Firefox all start their
+// deceleration from axis_stop, so without it they have no lift to react to and
+// the content stays exactly where the fingers left it.
+bool KineticState::shouldSuppressScrollEnd(const IPointer::SAxisEvent& e) const {
+    if (!getKineticConfigInt("enabled", 1) || !getKineticConfigInt("stop_on_lift", 0))
+        return false;
+
+    // Vertical only, and deliberately so. A browser's two-finger back/forward
+    // swipe is an overscroll gesture it commits, or snaps back, when the
+    // *horizontal* scroll sequence ends; withholding that axis_stop leaves the
+    // swipe hanging with nothing to resolve it. Nothing is lost by letting it
+    // through: libinput only emits a stop on the axes that were actually
+    // scrolling, and CSeatManager::sendPointerAxis sends axis_stop per axis, so
+    // dropping the vertical one still kills a client's vertical fling.
+    if (e.axis != WL_POINTER_AXIS_VERTICAL_SCROLL)
+        return false;
+
+    // libinput ends a two-finger scroll with a zero-delta event on the same
+    // axis, and CSeatManager::sendPointerAxis sends axis_stop for exactly that
+    // (`else if (value == 0)`) on any source but a wheel.
+    if (e.delta != 0.0 || e.deltaDiscrete != 0)
+        return false;
+
+    // Real wheels take the value120 branch there instead and never produce an
+    // axis_stop, but gate on the source anyway rather than relying on that.
+    const bool touchpadSource = (e.source == WL_POINTER_AXIS_SOURCE_FINGER || e.source == WL_POINTER_AXIS_SOURCE_CONTINUOUS);
+    const bool smoothMouse    = (e.mouse && e.deltaDiscrete == 0);
+    if (!touchpadSource && !smoothMouse)
+        return false;
+
+    // disabled_classes and the lua per-app rules stay in force, so a client
+    // that needs its scroll sequences terminated properly can be excluded.
+    // disable_in_browser is deliberately *not* consulted: it exists to leave a
+    // browser's native momentum alone, which is the opposite of what this does.
+    const auto PWIN = g_pInputManager ? g_pInputManager->m_lastMouseFocus.lock() : nullptr;
+    if (PWIN) {
+        if (classInList(PWIN->m_class, getKineticConfigString("disabled_classes", "")))
+            return false;
+
+        if (!shouldProcessForWindow(PWIN->m_class))
+            return false;
+    }
+
+    if (getKineticConfigInt("debug", 0)) {
+        std::ofstream log("/tmp/hypr-kinetic-scroll.log", std::ios::app);
+        if (log.is_open())
+            log << "[hypr-kinetic-scroll] suppressing scroll end (stop_on_lift) self=" << this << "\n";
+    }
+
+    return true;
+}
