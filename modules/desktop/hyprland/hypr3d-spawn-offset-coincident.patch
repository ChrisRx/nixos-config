+            // Every new entity wants the same pose -- straight ahead at the
+            // read distance, facing the camera -- so without a step along the
+            // view axis they land EXACTLY on top of each other: same centre,
+            // same yaw, same pitch, hence exactly coplanar at exactly one
+            // depth. Coplanar quads write depth and test GL_LESS, so equal
+            // depth is not less: whichever the traversal emits first wins
+            // every overlapping pixel and the rest are rejected outright.
+            // That is why a launcher (rofi, a quickshell panel) opened on top
+            // of a window never appeared -- its quad was not missing, it was
+            // depth-rejected by the window it had spawned inside.
+            //
+            // Pulling each new entity kSpawnStep nearer the camera than the
+            // ones already there separates the planes, which hands the
+            // ordering back to the BSP and composites them in the order they
+            // arrived: newest in front. That is also the 2D stacking the
+            // surfaces had before entering the room.
+            float distance = g_cfgSpawnDistance;
+
+            const auto OCCUPIED = [&](float d) {
+                const Vec3 C = CAM.position + FWD * d;
+
+                const auto NEAR_C = [&](const Vec3& o) {
+                    const Vec3 DELTA{C.x - o.x, C.y - o.y, C.z - o.z};
+                    return DELTA.x * DELTA.x + DELTA.y * DELTA.y +
+                        DELTA.z * DELTA.z < kSpawnEpsilon * kSpawnEpsilon;
+                };
+
+                // Both the previous frame's world (entities that persist) and
+                // the list being built right now: at activation EVERY entity
+                // is new in the same pass, so checking only g_world would let
+                // them all pile onto one point again.
+                for (const auto& E : g_world.entities())
+                    if (NEAR_C(E.center))
+                        return true;
+
+                for (const auto& E : ENTITIES)
+                    if (NEAR_C(E.center))
+                        return true;
+
+                return false;
+            };
+
+            // Bounded: a crowded room must not walk the spawn point into the
+            // camera's near plane, so the search gives up and accepts a
+            // shared point rather than spawning something unreachable.
+            for (int step = 0; step < kSpawnStepLimit && OCCUPIED(distance);
+                 ++step)
+                distance -= kSpawnStep;
+
+            entity.center = CAM.position + FWD * std::max(distance, kSpawnStep);
 
