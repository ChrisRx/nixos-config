+        // It is the same hazard syncWorld() documents for capture and ghosting,
+        // which is why those run from render.pre.
+        //
+        // The pump ticks every 8 ms, but ask for the next event loop iteration:
+        // until the teardown runs, the windows are still ghosted and this
+        // function adds no pass element, so every frame in between draws an
+        // empty room.
+        g_deactivatePending = true;
+
+        if (g_framePump)
+            g_framePump->updateTimeout(std::chrono::milliseconds(0));
+
         return;
     }
 
